---
import '../styles/global.css'
import Container from "./Container.astro";
import NavigationBar from "../components/NavigationBar.astro";
import navLinks from "../utils/navlinks";
import socials from "../utils/socials";
import IconedLink from "../components/IconedLink.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://rsms.me/">
		<link rel="stylesheet" href="https://rsms.me/inter/inter.css">
		<title>Matthew McCall</title>
	</head>
	<body class="h-dvh overflow-y-scroll">
		<div class="flex flex-col lg:flex-row lg:justify-evenly min-h-dvh pb-8 lg:pb-0">
            <aside class="sticky top-0 hidden items-center justify-center lg:h-screen lg:flex">
				<NavigationBar />
            </aside>
			<div class="flex grow lg:grow-0 items-center">
				<Container>
					<slot />
				</Container>
			</div>
            <div class="sticky bottom-0 flex items-center justify-center lg:invisible">
                <NavigationBar />
            </div>
        </div>
        <footer class="footer lg:footer-horizontal bg-base-200 text-base-content p-8">
           <aside>
               <p class="text-xl">mmccall.dev</p>
               <p>Copyright &copy; {new Date().getFullYear()} - All rights reserved.</p>
           </aside>
            <nav>
                <h6 class="footer-title">Links</h6>
                { navLinks.map(({link, title}) =>
                        <a href={link} class="link link-hover">{title}</a>)
                }
            </nav>
            <nav>
                <h6 class="footer-title">Socials</h6>
                <div class="flex flex-row gap-4 text-xl">
                    {socials.map(social => <IconedLink {...social} />)}
                </div>
            </nav>
        </footer>
        <div class="toast toast-end">
            <div id="cookie-toast" role="alert" class="alert alert-vertical shadow max-w-sm invisible">
                <span>I improve this website by using Microsoft Clarity to see how you use it. By selecting "Accept",
                    you agree that Microsoft and I can collect and use this data.</span>
                <div>
                    <button id="accept-cookie" class="btn btn-sm btn-primary">Accept</button>
                    <button id="decline-cookie" class="btn btn-sm btn-secondary">Deny</button>
                </div>
            </div>
        </div>
		<script>
			import Clarity from '@microsoft/clarity';
			Clarity.init(import.meta.env.PUBLIC_CLARITY_PROJECT_ID);

            const cookieToast = document.querySelector('#cookie-toast');
            const alreadyConsented = window.localStorage.getItem('clarity-consent');

            if (cookieToast) {
                if (alreadyConsented === null) {
                    cookieToast.classList.remove('invisible');

                    const acceptCookieButton = document.querySelector('#accept-cookie');
                    const declineCookieButton = document.querySelector('#decline-cookie');

                    if (acceptCookieButton)
                        acceptCookieButton.addEventListener('click', () => {
                            Clarity.consent(true);
                            window.localStorage.setItem('clarity-consent', 'accepted');
                            cookieToast.remove();
                        })

                    if (declineCookieButton)
                        declineCookieButton.addEventListener('click', () => {
                            Clarity.consent(false);
                            window.localStorage.setItem('clarity-consent', 'declined');
                            cookieToast.remove();
                        })
                } else {
                    Clarity.consent(alreadyConsented === 'accepted');
                    cookieToast.remove();
                }
            }
        </script>
	</body>
</html>
