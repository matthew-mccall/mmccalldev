---
import '../styles/global.css'

import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Container from "./Container.astro";
import NavigationBar from "../components/NavigationBar.astro";
import navLinks from "../utils/navlinks";
import socials from "../utils/socials";
import IconedLink from "../components/IconedLink.astro";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous"/>
    <title>Matthew McCall</title>
</head>
<body>
<div class="flex flex-col gap-5 min-h-dvh px-5 lg:flex-row lg:justify-evenly">
    <aside class="sticky top-0 hidden items-center justify-center lg:h-dvh lg:flex">
        <NavigationBar/>
    </aside>
    <div class="flex grow py-5 lg:grow-0 items-center">
        <Container>
            <slot/>
        </Container>
    </div>
    <div class="sticky bottom-0 flex items-center justify-center lg:invisible">
        <NavigationBar/>
    </div>
</div>
<footer class="footer footer-horizontal footer-center bg-base-200 text-base-content py-10 px-5">
    <nav class="flex flex-row gap-4">
        {navLinks.map(({link, title}) =>
                <a href={link} class="link link-hover">{title}</a>)
        }
    </nav>
    <nav>
        <div class="flex flex-row gap-4 text-xl">
            {socials.map(social =>
                    <IconedLink {...social}/>)}
        </div>
    </nav>
    <aside class="max-w-xl">
        <p class="text-xl">mmccall.dev</p>
        <p>Copyright &copy; {new Date().getFullYear()} - All rights reserved.</p>
        <small class="text-left">We partner with Microsoft Clarity and Microsoft Advertising to capture how you use and interact with our
            website through behavioral metrics, heatmaps, and session replay to improve and market our
            products/services. Website usage data is captured using first and third-party cookies and other tracking
            technologies to determine the popularity of products/services and online activity. Additionally, we use this
            information for site optimization, fraud/security purposes, and advertising. For more information about how
            Microsoft collects and uses your data, visit the <a href="https://www.microsoft.com/privacy/privacystatement">Microsoft Privacy Statement</a>.</small>
    </aside>
</footer>
<div class="toast toast-end">
    <div id="cookie-toast" role="alert" class="alert alert-vertical shadow max-w-sm invisible">
                <span>I improve this website by using Microsoft Clarity to see how you use it. By selecting "Accept",
                    you agree that Microsoft and I can collect and use this data.</span>
        <div>
            <button id="accept-cookie" class="btn btn-sm btn-primary">Accept</button>
            <button id="decline-cookie" class="btn btn-sm btn-secondary">Deny</button>
        </div>
    </div>
</div>
<script>
    import Clarity from '@microsoft/clarity';

    Clarity.init(import.meta.env.PUBLIC_CLARITY_PROJECT_ID);

    const cookieToast = document.querySelector('#cookie-toast');
    const alreadyConsented = window.localStorage.getItem('clarity-consent');

    if (cookieToast) {
        if (alreadyConsented === null) {
            cookieToast.classList.remove('invisible');

            const acceptCookieButton = document.querySelector('#accept-cookie');
            const declineCookieButton = document.querySelector('#decline-cookie');

            if (acceptCookieButton)
                acceptCookieButton.addEventListener('click', () => {
                    Clarity.consent(true);
                    window.localStorage.setItem('clarity-consent', 'accepted');
                    cookieToast.remove();
                })

            if (declineCookieButton)
                declineCookieButton.addEventListener('click', () => {
                    Clarity.consent(false);
                    window.localStorage.setItem('clarity-consent', 'declined');
                    cookieToast.remove();
                })
        } else {
            Clarity.consent(alreadyConsented === 'accepted');
            cookieToast.remove();
        }
    }
</script>
</body>
</html>
