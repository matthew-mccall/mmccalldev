---
import Sunlit from '../components/Sunlit.astro'
import '../styles/global.css'

const navLinks = [
	{ link: '/', title: 'home' },
	{ link: '/papers', title: 'papers' },
	{ link: '/resume.pdf', title: 'resume' },
];

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Matthew McCall</title>
	</head>
	<body class="dark:text-gray-300 dark:bg-black font-sans">
	<div class="px-5 max-w-4xl mx-auto text-lg/[2]">
		<div class="flex flex-col h-svh">
			<nav class="flex flex-row justify-center pb-6 order-last md:order-first md:pt-6">
				{ navLinks.map(({link, title}) => <a href={link} class:list={["font-bold px-4 underline-offset-4", currentPath === link && "border rounded-full no-underline"]}>{title}</a>)}
			</nav>
			<slot />
		</div>
	</div>
	</body>
</html>
