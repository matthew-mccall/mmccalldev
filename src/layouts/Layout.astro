---
import Sunlit from '../components/Sunlit.astro'
import '../styles/global.css'

const navLinks = [
	{ link: '/', title: 'home' },
	{ link: '/papers', title: 'papers' },
	{ link: '/resume.pdf', title: 'resume' },
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Matthew McCall</title>
	</head>
	<body class="text-amber-950 border-t-amber-950 dark:text-sky-100 dark:border-t-sky-100">
		<Sunlit>
			<div class="px-5 md:max-w-[8.5in] md:px-[1in] mx-auto text-lg/[2] font-serif">
				<div class="flex flex-col h-svh">
					<nav class="flex flex-row justify-center py-4">
						{ navLinks.map(({link, title}) => <a href={link} class:list={["font-bold px-4 underline-offset-4", Astro.url.pathname === link && "border rounded-full no-underline"]}>{title}</a>)}
					</nav>
					<slot />
					<footer class="py-4 text-center">
						<small>Credit to <a href="https://github.com/jackyzha0/sunlit">jackyzha0/sunlit</a> for effects</small>
					</footer>
				</div>
			</div>
		</Sunlit>
	</body>
</html>
