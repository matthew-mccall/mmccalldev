---
import Layout from "./Layout.astro";
import { formatDate } from "../utils/formatDate";

// Handle both direct frontmatter and content collection entry
const { frontmatter, entry } = Astro.props;
const title = entry?.data?.title || frontmatter?.title;
const date = entry?.data?.date || frontmatter?.date;
const formattedDate = date ? formatDate(date) : null;
---

<Layout>
    <main class="flex flex-col gap-5">
        <div>
            <h1>{title}</h1>
            {formattedDate && <p class="text-gray-500 dark:text-gray-400 mt-2">{formattedDate}</p>}
        </div>
        <hr />
        <article>
            <slot />
        </article>
    </main>
</Layout>
