---
import { TabbedCard } from '@/components/ui/tabbed-card'
import PageLayout from '@/layouts/PageLayout.astro'
import papers from '@/data/papers.json'
---

<PageLayout title="Papers" description="Academic papers published by Matthew McCall.">
    <header class="flex flex-col gap-4 pb-12">
        <h1 class="severance-overline border-khaki/40 pt-8 font-display text-5xl font-bold leading-none text-khaki-light md:text-6xl">
            Academic Papers
        </h1>
        <p class="text-lg leading-relaxed text-khaki-light/80 md:text-xl">
            The following is a list of my published works
        </p>
    </header>

    <div class="flex flex-col gap-8">
        {papers.map((paper) => (
            <TabbedCard colorScheme="maroon" density="comfy" hover>
                <span slot="tab" class="text-khaki">Paper</span>
                <h2 class="font-display text-2xl font-semibold text-khaki-light md:text-3xl">{paper.title}</h2>
                <p class="text-base leading-relaxed text-khaki-light/80">
                    <strong class="text-khaki-light">Abstract:</strong> {paper.abstract}
                </p>
                <div class="pt-2">
                    <a
                        href={paper.href}
                        class="inline-flex items-center gap-2 rounded-full bg-khaki px-6 py-3 text-sm font-medium uppercase tracking-[0.2em] text-maroon transition-colors duration-300 hover:bg-khaki-light"
                    >
                        Download PDF <i class="bi-filetype-pdf" aria-hidden="true"></i>
                    </a>
                </div>
            </TabbedCard>
        ))}
    </div>
</PageLayout>
