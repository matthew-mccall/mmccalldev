---
// Supports weights 300-800
import '@fontsource-variable/host-grotesk';

import '@/styles/global.css'
import ContourMap from '@/components/ContourMap/ContourMap.astro'
import IconedLink from '@/components/IconedLink.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import TimelineCard from '@/components/TimelineCard.astro'
import projects from '@/data/projects.json'
import socials from '@/data/socials.json'
import timeline from '@/data/timeline.json'

const year = new Date().getFullYear()
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Matthew McCall — Team Member @ BETA working on Airborne Software." />
		<title>Matthew McCall</title>
		<script is:inline>document.documentElement.classList.add('js')</script>
	</head>
	<body>
		<ContourMap />
		<main>
			<!-- Hero -->
			<section class="relative flex min-h-svh flex-col justify-center bg-linear-to-b from-maroon-deep/85 via-maroon/70 to-maroon/85">
				<div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 py-24 md:px-12 lg:grid-cols-[3fr_2fr]">
					<div class="flex flex-col gap-8">
						<div class="flex flex-col">
							<div class="h-px w-full bg-khaki/40" aria-hidden="true"></div>
						</div>
						<h1 class="font-display text-6xl font-bold leading-none text-khaki-light sm:text-7xl lg:text-8xl xl:text-9xl">
							Matthew McCall
						</h1>
						<p class="max-w-2xl text-xl leading-relaxed text-khaki-light/90 md:text-2xl">
							Team Member <a href="https://beta.team" class="text-khaki hover:text-khaki-light">@ BETA</a> working on Airborne Software
						</p>
						<nav aria-label="Social links" class="flex flex-wrap gap-x-6 gap-y-3 pt-2 text-2xl">
							{socials.map((social) => (
								<IconedLink {...social} class="text-khaki hover:text-khaki-light" />
							))}
						</nav>
					</div>
					<picture class="hidden justify-self-end lg:block">
						<source srcset="/portrait.jxl" type="image/jxl" />
						<img
							src="/portrait.webp"
							alt="Portrait of Matthew McCall"
							class="max-h-[70svh] w-full object-cover object-top"
							loading="eager"
						/>
					</picture>
				</div>
				<p class="absolute bottom-8 left-1/2 -translate-x-1/2 text-xs uppercase tracking-[0.35em] text-khaki/60">
					Scroll &darr;
				</p>
			</section>

			<!-- Projects -->
			<section class="bg-linear-to-b from-khaki/95 via-khaki/85 to-khaki-dark/90 text-maroon">
				<div class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-6 py-24 md:px-12 md:py-32">
					<header class="flex flex-col gap-4">
						<div class="flex flex-col">
							<div class="h-px w-full bg-maroon/40" aria-hidden="true"></div>
						</div>
						<h2 class="font-display text-4xl font-bold md:text-5xl">Projects</h2>
					</header>
					<div class="grid gap-6 md:grid-cols-3">
						{projects.map((project) => <ProjectCard {...project} />)}
					</div>
				</div>
			</section>

			<!-- Timeline -->
			<section class="timeline-section bg-linear-to-b from-crimson-deep/90 via-crimson-deep/80 to-maroon-deep/90 text-khaki-light" data-timeline-section>
				<div class="timeline-pin flex flex-col gap-6 py-12 md:gap-10 md:py-24">
					<header class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-6 md:px-12">
						<div class="flex flex-col">
							<div class="h-px w-full bg-khaki/40" aria-hidden="true"></div>
						</div>
						<h2 class="font-display text-4xl font-bold md:text-5xl">Timeline</h2>
						<p class="timeline-hint text-xs uppercase tracking-[0.3em] text-khaki/60">
							Keep scrolling &mdash; the timeline pans with you
						</p>
					</header>
					<div class="timeline-viewport mx-auto w-full max-w-6xl px-6 md:px-12">
						<div class="timeline-track" data-timeline-track>
							{timeline.map((item) => (
								<TimelineCard title={item.title} body={item.body} badgeText={item.badgeText} />
							))}
						</div>
					</div>
					<div class="timeline-progress mx-6 md:mx-12" aria-hidden="true">
						<div class="timeline-progress-bar" data-timeline-progress></div>
					</div>
				</div>
			</section>
		</main>

		<footer class="border-t border-khaki/20 bg-linear-to-b from-maroon-deep to-black/90">
			<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-12 md:flex-row md:items-center md:justify-between md:px-12">
				<div class="flex flex-col gap-1">
					<p class="font-display text-xl font-semibold text-khaki-light">Matthew McCall</p>
					<p class="text-sm text-khaki/70">&copy; {year} &mdash; All rights reserved.</p>
				</div>
				<nav aria-label="Footer social links" class="flex flex-wrap gap-x-5 gap-y-2 text-xl">
					{socials.map((social) => (
						<IconedLink {...social} class="text-khaki hover:text-khaki-light" />
					))}
				</nav>
			</div>
		</footer>

		<script>
			import { applySquircles } from '@/lib/squircle'

			// Bezier superellipse corners; CSS border-radius remains the no-JS fallback
			applySquircles()
		</script>

		<script>
			import gsap from 'gsap'
			import { ScrollTrigger } from 'gsap/ScrollTrigger'

			gsap.registerPlugin(ScrollTrigger)

			const section = document.querySelector<HTMLElement>('[data-timeline-section]')
			const track = document.querySelector<HTMLElement>('[data-timeline-track]')
			const progress = document.querySelector<HTMLElement>('[data-timeline-progress]')

			const matchMedia = gsap.matchMedia()

			matchMedia.add('(prefers-reduced-motion: no-preference)', () => {
				// Fade project cards in as they scroll into view
				gsap.utils.toArray<HTMLElement>('[data-fade]').forEach((card, i) => {
					gsap.from(card, {
						opacity: 0,
						y: 32,
						duration: 0.7,
						ease: 'power2.out',
						delay: (i % 3) * 0.1,
						scrollTrigger: {
							trigger: card,
							start: 'top 88%',
							toggleActions: 'play none none reverse',
						},
					})
				})

				if (!section || !track) return

				const cards = gsap.utils.toArray<HTMLElement>('.timeline-card', track)
				if (cards.length === 0) return

				const first = cards[0]
				const last = cards[cards.length - 1]

				// Start with the first card near the center of the screen and stop
				// panning once the last card reaches the center — the pin then
				// releases and normal scrolling continues to the footer.
				const startX = () => window.innerWidth / 2 - (first.offsetLeft + first.offsetWidth / 2)
				const endX = () => window.innerWidth / 2 - (last.offsetLeft + last.offsetWidth / 2)
				const distance = () => Math.max(1, startX() - endX())

				const pan = gsap.fromTo(
					track,
					{ x: startX },
					{
						x: endX,
						ease: 'none',
						scrollTrigger: {
							trigger: section,
							start: 'top top',
							end: () => `+=${distance()}`,
							pin: true,
							scrub: 1,
							anticipatePin: 1,
							invalidateOnRefresh: true,
							onUpdate: (self) => {
								if (progress) progress.style.transform = `scaleX(${self.progress})`
							},
						},
					},
				)

				// Fade each timeline card in as the horizontal pan brings it into view
				cards.forEach((card) => {
					gsap.from(card, {
						opacity: 0,
						y: 48,
						duration: 0.6,
						ease: 'power2.out',
						scrollTrigger: {
							trigger: card,
							containerAnimation: pan,
							start: 'left 92%',
							toggleActions: 'play none none reverse',
						},
					})
				})
			})
		</script>
	</body>
</html>
