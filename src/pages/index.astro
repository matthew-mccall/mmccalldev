---
// Supports weights 300-800
import '@fontsource-variable/host-grotesk';

import '@/styles/global.css'
import { ContourMap } from '@/components/ui/contour-map'
import { IconedLink } from '@/components/ui/iconed-link'
import { NavBar } from '@/components/ui/nav-bar'
import { SiteFooter } from '@/components/ui/site-footer'
import { Tab } from '@/components/ui/tab'
import { TabbedCard } from '@/components/ui/tabbed-card'
import projects from '@/data/projects.json'
import socials from '@/data/socials.json'
import timeline from '@/data/timeline.json'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Matthew McCall — Team Member @ BETA working on Airborne Software." />
		<title>Matthew McCall</title>
		<script is:inline>document.documentElement.classList.add('js')</script>
	</head>
	<body>
		<!--
			Global background: the screen-locked contour map sits behind every
			section, and each section lays its own translucent color wash over
			it — red for the hero and timeline, khaki for Projects. The contour
			shows through everywhere, while the differing washes keep the layers
			visually distinct — that contrast is what makes the parallax
			cover/reveal readable. Projects and Timeline additionally carry
			their own opaque mirror copies so they occlude the sticky hero.
		-->
		<ContourMap />
		<NavBar />
		<main>
			<!-- Hero -->
			<!--
				CSS-only parallax backplane: the hero stays pinned while the lower
				stacking stage moves over it in normal document flow.
			-->
			<section class="sticky top-0 z-0 flex min-h-svh flex-col justify-center overflow-hidden bg-linear-to-b from-maroon-deep/80 via-maroon/60 to-maroon/80" data-hero-section>
				<div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 py-24 md:px-12 lg:grid-cols-[3fr_2fr]">
					<div class="flex flex-col gap-8">
						<h1 class="severance-overline border-khaki/40 pt-8 font-display text-6xl font-bold leading-none text-khaki-light sm:text-7xl lg:text-8xl xl:text-9xl">
							Matthew McCall
						</h1>
						<p class="max-w-2xl text-xl leading-relaxed text-khaki-light/90 md:text-2xl">
							Team Member <a href="https://beta.team" class="text-khaki hover:text-khaki-light">@ BETA</a> working on Airborne Software
						</p>
						<nav aria-label="Social links" class="flex flex-wrap gap-x-6 gap-y-3 pt-2 text-2xl">
							{socials.map((social) => (
								<IconedLink {...social} class="text-khaki hover:text-khaki-light" />
							))}
						</nav>
					</div>
					<picture class="hidden justify-self-end lg:block">
						<source srcset="/portrait.jxl" type="image/jxl" />
						<img
							src="/portrait.webp"
							alt="Portrait of Matthew McCall"
							class="max-h-[70svh] w-full object-cover object-top"
							loading="eager"
						/>
					</picture>
				</div>
			</section>

			<div class="parallax-stage" data-parallax-stage>
				<!-- Projects -->
			<!--
				This layer deliberately has no viewport-based height. Its content
				determines its size, allowing the sticky hero above and the timeline
				below to remain visible together as this section crosses the screen.
			-->
			<section class="relative z-20 text-maroon shadow-[0_-2px_12px_rgb(20_7_5/0.7),0_-32px_64px_rgb(20_7_5/0.55)]" data-projects-section>
				<!--
					Opaque contour backdrop: every section shares the screen-locked
					contour map, but this layer slides over the hero and timeline, so
					it can't be transparent — their content would show through. The
					mirror canvas is a per-frame copy of the fixed master (see
					ContourMap) and is position: fixed itself; clip-path — unlike
					overflow, it clips fixed descendants too — trims it to this
					wrapper's box. On top of the canvas sits the section's khaki wash;
					it scrolls with the section (position: absolute) and its top stop
					is fully opaque so the browser tab above can match it seamlessly,
					fading down so the contour texture shows through the body of the
					section. Together with the shadows (a tight dark edge plus a wide
					soft falloff above) the wash makes the layer read as a
					distinct surface sliding over the red sections.
				-->
				<div class="absolute inset-0 -z-10 [clip-path:inset(0)]" aria-hidden="true">
					<canvas class="fixed inset-0 h-full w-full" data-contour-mirror></canvas>
					<div class="absolute inset-0 bg-linear-to-b from-khaki via-khaki/85 to-khaki-dark/90"></div>
				</div>
				<!--
					Centered browser-style tab peeking up into the hero. Its fill
					matches the khaki wash's opaque top stop and it runs
					1px into the section so it reads as the same surface with no
					hairline seam along the join. Its compact negative drop shadow
					stays above the tab and joins the section's top shadow.
				-->
				<Tab align="center" class="absolute -top-8 left-1/2 h-[calc(2rem+1px)] -translate-x-1/2 text-khaki" labelClass="px-6">
					<span class="text-xs uppercase tracking-[0.35em] text-maroon/70">Scroll &darr;</span>
				</Tab>
				<div class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-6 py-24 md:px-12 md:py-32">
					<header class="flex flex-col gap-4">
						<h2 class="severance-overline border-maroon/40 pt-4 font-display text-4xl font-bold md:text-5xl">Projects</h2>
					</header>
					<div class="grid gap-6 md:grid-cols-3">
						{projects.map((project) => (
							<TabbedCard
								href={project.href}
								colorScheme="khaki"
								density="comfy"
								hover
								data-fade
							>
								<h3 class="font-display text-3xl font-bold text-maroon transition-colors duration-300 group-hover:text-khaki-light group-focus-visible:text-khaki-light">{project.title}</h3>
								<p class="text-base leading-relaxed text-maroon/80 transition-colors duration-300 group-hover:text-khaki-light/80 group-focus-visible:text-khaki-light/80">{project.description}</p>
								<span class="mt-auto inline-flex items-center gap-2 pt-2 text-sm uppercase tracking-[0.2em] text-maroon/70 transition-colors duration-300 group-hover:text-khaki group-focus-visible:text-khaki">
									Visit <i class="bi-arrow-up-right" aria-hidden="true"></i>
								</span>
							</TabbedCard>
						))}
					</div>
				</div>
			</section>

			<!-- Timeline -->
			<!--
				The Timeline fills the complete lower-section stage and its inner panel
				is viewport-fixed, clipped to the stage box (see .timeline-section), so
				it never rides along with the scroll: Projects peels away above it and
				the footer slides over it below while the panel holds still. The
				in-flow spacer below supplies the horizontal pan's scroll distance; GSAP
				therefore never needs to pin or transform this CSS-fixed surface.
			-->
			<section class="timeline-section relative z-10 text-khaki-light" data-timeline-section>
				<div class="absolute inset-0 -z-10 [clip-path:inset(0)]" aria-hidden="true">
					<canvas class="fixed inset-0 h-full w-full" data-contour-mirror></canvas>
					<div class="absolute inset-0 bg-linear-to-b from-crimson-deep/85 via-crimson-deep/70 to-maroon-deep/85"></div>
				</div>
				<div class="timeline-pin flex flex-col gap-6 py-12 md:gap-10 md:py-24" data-timeline-pin>
					<header class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-6 md:px-12">
						<div class="timeline-progress" aria-hidden="true">
							<div class="timeline-progress-bar" data-timeline-progress></div>
						</div>
						<h2 class="font-display text-4xl font-bold md:text-5xl">Timeline</h2>
						<p class="timeline-hint text-xs uppercase tracking-[0.3em] text-khaki/60">
							Keep scrolling &mdash; the timeline pans with you
						</p>
					</header>
					<div class="timeline-viewport mx-auto w-full max-w-6xl px-6 md:px-12">
						<div class="timeline-track" data-timeline-track>
							{timeline.map((item) => (
								<article class="timeline-card">
									<div class="timeline-card-rail" aria-hidden="true"></div>
									<TabbedCard
										colorScheme="maroon"
										density="cozy"
										hover={false}
										class="h-full w-full"
									>
										<span slot="tab" class="text-khaki">{item.badgeText}</span>
										<h3 class="text-xl font-semibold text-khaki-light">{item.title}</h3>
										<ul class="flex list-disc flex-col gap-2 pl-4 text-sm leading-relaxed text-khaki-light/80 marker:text-khaki-dark">
											{item.body.map((line) => <li>{line}</li>)}
										</ul>
									</TabbedCard>
								</article>
							))}
						</div>
					</div>
				</div>
			</section>
				<div class="timeline-scroll-space" aria-hidden="true"></div>
			</div>
		</main>

		<SiteFooter />

		<script>
			import { applySquircles } from '@/lib/squircle'

			// Bezier superellipse corners; CSS border-radius remains the no-JS fallback
			applySquircles()
		</script>

		<script>
			import gsap from 'gsap'
			import { ScrollTrigger } from 'gsap/ScrollTrigger'

			gsap.registerPlugin(ScrollTrigger)

			const section = document.querySelector<HTMLElement>('[data-timeline-section]')
			const projectsSection = document.querySelector<HTMLElement>('[data-projects-section]')
			const stage = document.querySelector<HTMLElement>('[data-parallax-stage]')
			const track = document.querySelector<HTMLElement>('[data-timeline-track]')
			const progress = document.querySelector<HTMLElement>('[data-timeline-progress]')

			const matchMedia = gsap.matchMedia()

			matchMedia.add('(prefers-reduced-motion: no-preference)', () => {
				// Fade project cards in one after the other — each successive card
				// starts later, but well within the previous card's 0.7s window so
				// the fades overlap
				gsap.utils.toArray<HTMLElement>('[data-fade]').forEach((card, i) => {
					gsap.from(card, {
						opacity: 0,
						y: 32,
						duration: 0.7,
						ease: 'power2.out',
						delay: i * 0.15,
						scrollTrigger: {
							trigger: card,
							start: 'top 88%',
							toggleActions: 'play none none reverse',
						},
					})
				})

				if (!section || !projectsSection || !stage || !track) return

				const cards = gsap.utils.toArray<HTMLElement>('.timeline-card', track)
				if (cards.length === 0) return

				const first = cards[0]
				const last = cards[cards.length - 1]

				// Start with the first card near the center of the screen and stop
				// panning once the last card reaches the center — the pin then
				// releases and normal scrolling continues to the footer.
				const startX = () => window.innerWidth / 2 - (first.offsetLeft + first.offsetWidth / 2)
				const endX = () => window.innerWidth / 2 - (last.offsetLeft + last.offsetWidth / 2)
				const distance = () => {
					const value = Math.max(1, startX() - endX())
					stage.style.setProperty('--timeline-pan-distance', `${value}px`)
					return value
				}

				const pan = gsap.fromTo(
					track,
					{ x: startX },
					{
						x: endX,
						ease: 'none',
							scrollTrigger: {
								trigger: projectsSection,
								start: 'bottom top',
								end: () => `+=${distance()}`,
							scrub: 1,
							anticipatePin: 1,
							invalidateOnRefresh: true,
							onUpdate: (self) => {
								if (progress) progress.style.transform = `scaleX(${self.progress})`
							},
						},
					},
				)

				// Fade each timeline card in as the horizontal pan brings it into view
				cards.forEach((card) => {
					gsap.from(card, {
						opacity: 0,
						y: 48,
						duration: 0.6,
						ease: 'power2.out',
						scrollTrigger: {
							trigger: card,
							containerAnimation: pan,
							start: 'left 92%',
							toggleActions: 'play none none reverse',
						},
					})
				})
			})
		</script>
	</body>
</html>
