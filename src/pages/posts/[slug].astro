---
import { getCollection, render } from 'astro:content'
import PageLayout from '@/layouts/PageLayout.astro'
import { formatDate } from '@/lib/formatDate'

export async function getStaticPaths() {
    const posts = await getCollection('posts')
    return posts.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<PageLayout title={entry.data.title}>
    <article class="flex flex-col gap-10">
        <header class="flex flex-col gap-4">
            <h1 class="severance-overline border-khaki/40 pt-8 font-display text-4xl font-bold leading-tight text-khaki-light md:text-5xl">
                {entry.data.title}
            </h1>
            <time datetime={entry.data.date.toISOString().slice(0, 10)} class="text-sm uppercase tracking-[0.2em] text-khaki/70">
                {formatDate(entry.data.date)}
            </time>
        </header>
        <div class="prose-post">
            <Content />
        </div>
        <nav class="pt-4">
            <a href="/posts" class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] text-khaki transition-colors hover:text-khaki-light">
                <i class="bi-arrow-left" aria-hidden="true"></i> All posts
            </a>
        </nav>
    </article>
</PageLayout>
