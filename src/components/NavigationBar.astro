---
import '../styles/global.css'
import Container from "../layouts/Container.astro";

const navLinks = [
    { link: '/', title: 'home' },
    { link: '/posts', title: 'posts' },
    { link: '/papers', title: 'papers' },
    { link: '/resume.pdf', title: 'resume' },
];

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<div class="py-2 pointer-events-auto flex flex-row justify-center">
    <nav>
        <ul class="menu menu-horizontal rounded-full bg-base-200 md:menu-vertical md:rounded">
            { navLinks.map(({link, title}) =>
                <li><a href={link} class=`rounded-full md:rounded-sm ${currentPath === link && 'menu-active no-underline'}`>{title}</a></li>)
            }
        </ul>
    </nav>
</div>
