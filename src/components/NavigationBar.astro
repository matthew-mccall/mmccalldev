---
import '../styles/global.css'
import Container from "../layouts/Container.astro";

const navLinks = [
    { link: '/', title: 'home' },
    { link: '/papers', title: 'papers' },
    { link: '/resume.pdf', title: 'resume' },
];

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<div class="py-2 pointer-events-auto flex flex-row justify-center">
    <nav class="flex flex-row justify-center bg-white dark:bg-black rounded-full border p-2">
        { navLinks.map(({link, title}) => <a href={link} class:list={["border py-2 px-4", currentPath === link && "rounded-full no-underline", currentPath == link ? "border-black dark:border-white" : "border-transparent"]}>{title}</a>)}

    </nav>
</div>
