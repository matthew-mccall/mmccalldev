---
import '../styles/global.css'
import Container from "../layouts/Container.astro";

const navLinks = [
    { link: '/', title: 'home' },
    { link: '/papers', title: 'papers' },
    { link: '/resume.pdf', title: 'resume' },
];

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<div class="py-4 pointer-events-auto flex flex-row justify-center">
    <nav class="flex flex-row justify-center bg-white dark:bg-black rounded-full border border-gray-500 p-2">
        { navLinks.map(({link, title}) => <a href={link} class:list={["font-bold py-2 px-4 underline-offset-4", currentPath === link && "border rounded-full no-underline"]}>{title}</a>)}
    </nav>
</div>
