---
import '../styles/global.css'
import Container from "../layouts/Container.astro";

const navLinks = [
    { link: '/', title: 'home' },
    { link: '/papers', title: 'papers' },
    { link: '/resume.pdf', title: 'resume' },
];

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<div class="py-4 bg-white dark:bg-black border-gray-500 border-t md:border-t-0 md:border-b">
    <Container>
        <nav class="flex flex-row justify-center">
            { navLinks.map(({link, title}) => <a href={link} class:list={["font-bold px-4 underline-offset-4", currentPath === link && "border rounded-full no-underline"]}>{title}</a>)}
        </nav>
    </Container>
</div>
