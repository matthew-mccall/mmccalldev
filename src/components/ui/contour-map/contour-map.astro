<div id="contour-container" class="fixed inset-0 -z-10 h-full w-full overflow-hidden bg-maroon"></div>

<script>
    import vertexShaderSource from './vertex.glsl?raw'
    import fragmentShaderSource from './fragment.glsl?raw'

    const TARGET_FPS = 30
    const FRAME_INTERVAL = 1000 / TARGET_FPS
    const RENDER_SCALE = 0.65
    const RESIZE_DEBOUNCE_MS = 150

    const container = document.getElementById('contour-container')
    if (container) initializeContourMap(container)

    function initializeContourMap(container: HTMLElement): void {
        const canvas = document.createElement('canvas')
        canvas.className = 'block h-full w-full'
        canvas.setAttribute('aria-hidden', 'true')
        container.appendChild(canvas)

        const gl = canvas.getContext('webgl', {
            alpha: false,
            antialias: false,
            powerPreference: 'low-power',
        })
        if (!gl || !gl.getExtension('OES_standard_derivatives')) return

        function compileShader(type: number, source: string): WebGLShader {
            const shader = gl.createShader(type)
            if (!shader) throw new Error('Unable to create contour shader')

            gl.shaderSource(shader, source)
            gl.compileShader(shader)

            if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
                const message = gl.getShaderInfoLog(shader) ?? 'Unknown shader compilation error'
                gl.deleteShader(shader)
                throw new Error(message)
            }

            return shader
        }

        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexShaderSource)
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentShaderSource)
        const program = gl.createProgram()
        if (!program) throw new Error('Unable to create contour shader program')

        gl.attachShader(program, vertexShader)
        gl.attachShader(program, fragmentShader)
        gl.linkProgram(program)

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
            throw new Error(gl.getProgramInfoLog(program) ?? 'Unable to link contour shader program')
        }

        gl.useProgram(program)

        const positionBuffer = gl.createBuffer()
        if (!positionBuffer) throw new Error('Unable to create contour geometry')

        gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer)
        gl.bufferData(
            gl.ARRAY_BUFFER,
            new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
            gl.STATIC_DRAW,
        )

        const positionLocation = gl.getAttribLocation(program, 'aPosition')
        gl.enableVertexAttribArray(positionLocation)
        gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0)

        const uniforms = {
            time: gl.getUniformLocation(program, 'uTime'),
            resolution: gl.getUniformLocation(program, 'uResolution'),
            mouse: gl.getUniformLocation(program, 'uMouse'),
        }

        gl.uniform1f(gl.getUniformLocation(program, 'uSeed'), Math.random() * 10000)
        gl.uniform1f(gl.getUniformLocation(program, 'uNoiseScale'), 2.5)
        gl.uniform1f(gl.getUniformLocation(program, 'uNoiseSpeed'), 0.01)
        gl.uniform1f(gl.getUniformLocation(program, 'uDensity'), 5)
        gl.uniform1f(gl.getUniformLocation(program, 'uLineWidth'), 2)
        gl.uniform1f(gl.getUniformLocation(program, 'uMouseRadius'), 0.7)
        gl.uniform1f(gl.getUniformLocation(program, 'uMouseStrength'), 0.5)
        gl.uniform3f(gl.getUniformLocation(program, 'uBgColor'), 30 / 255, 12 / 255, 9 / 255)
        gl.uniform3f(gl.getUniformLocation(program, 'uLineColor'), 138 / 255, 122 / 255, 85 / 255)

        type Mirror = {
            canvas: HTMLCanvasElement
            context: CanvasRenderingContext2D
            root: Element
            visible: boolean
        }

        const mirrors: Mirror[] = Array.from(
            document.querySelectorAll<HTMLCanvasElement>('canvas[data-contour-mirror]'),
        ).flatMap((mirrorCanvas) => {
            const context = mirrorCanvas.getContext('2d')
            if (!context) return []

            return [{
                canvas: mirrorCanvas,
                context,
                root: mirrorCanvas.closest('[data-projects-section], [data-timeline-section]') ?? mirrorCanvas,
                visible: typeof IntersectionObserver === 'undefined',
            }]
        })

        let animationTime = 0
        let animationFrameId = 0
        let lastAnimationTime = performance.now()
        let lastFrameTime = 0
        let mouseX = -10
        let mouseY = -10
        let resizeTimer: number | undefined

        const motionMediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
        let motionEnabled = !motionMediaQuery.matches

        function drawFrame(): void {
            gl.uniform1f(uniforms.time, animationTime * 0.001)
            gl.uniform2f(uniforms.mouse, mouseX, mouseY)
            gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)

            for (const mirror of mirrors) {
                if (mirror.visible) mirror.context.drawImage(canvas, 0, 0)
            }
        }

        function animate(currentTime: number): void {
            animationFrameId = window.requestAnimationFrame(animate)

            const elapsed = currentTime - lastFrameTime
            if (elapsed < FRAME_INTERVAL) return

            animationTime += Math.min(currentTime - lastAnimationTime, 100)
            lastAnimationTime = currentTime
            lastFrameTime = currentTime - (elapsed % FRAME_INTERVAL)
            drawFrame()
        }

        function syncAnimationLoop(): void {
            window.cancelAnimationFrame(animationFrameId)
            animationFrameId = 0

            if (motionEnabled && !document.hidden) {
                lastAnimationTime = performance.now()
                lastFrameTime = 0
                animationFrameId = window.requestAnimationFrame(animate)
            } else if (!document.hidden) {
                drawFrame()
            }
        }

        function resizeCanvas(): void {
            const viewport = window.visualViewport
            const cssWidth = Math.max(1, Math.round(viewport?.width ?? window.innerWidth))
            const cssHeight = Math.max(1, Math.round(viewport?.height ?? window.innerHeight))
            const renderWidth = Math.max(1, Math.round(cssWidth * RENDER_SCALE))
            const renderHeight = Math.max(1, Math.round(cssHeight * RENDER_SCALE))

            canvas.width = renderWidth
            canvas.height = renderHeight
            gl.viewport(0, 0, renderWidth, renderHeight)
            gl.uniform2f(uniforms.resolution, renderWidth, renderHeight)

            for (const mirror of mirrors) {
                mirror.canvas.width = renderWidth
                mirror.canvas.height = renderHeight
            }

            drawFrame()
        }

        function scheduleResize(): void {
            window.clearTimeout(resizeTimer)
            resizeTimer = window.setTimeout(resizeCanvas, RESIZE_DEBOUNCE_MS)
        }

        function handlePointerMove(event: PointerEvent): void {
            mouseX = event.clientX / window.innerWidth
            mouseY = 1 - event.clientY / window.innerHeight
        }

        function handleMotionChange(): void {
            const nextMotionEnabled = !motionMediaQuery.matches
            if (nextMotionEnabled === motionEnabled) return

            motionEnabled = nextMotionEnabled
            if (motionEnabled) {
                window.addEventListener('pointermove', handlePointerMove, { passive: true })
            } else {
                window.removeEventListener('pointermove', handlePointerMove)
            }
            syncAnimationLoop()
        }

        const mirrorsByRoot = new Map<Element, Mirror[]>()
        for (const mirror of mirrors) {
            const rootMirrors = mirrorsByRoot.get(mirror.root) ?? []
            rootMirrors.push(mirror)
            mirrorsByRoot.set(mirror.root, rootMirrors)
        }

        const mirrorObserver = typeof IntersectionObserver === 'undefined'
            ? undefined
            : new IntersectionObserver((entries) => {
                for (const entry of entries) {
                    for (const mirror of mirrorsByRoot.get(entry.target) ?? []) {
                        mirror.visible = entry.isIntersecting
                    }
                }
                if (!motionEnabled && !document.hidden) drawFrame()
            })

        for (const root of mirrorsByRoot.keys()) mirrorObserver?.observe(root)

        if (motionEnabled) {
            window.addEventListener('pointermove', handlePointerMove, { passive: true })
        }
        motionMediaQuery.addEventListener('change', handleMotionChange)
        document.addEventListener('visibilitychange', syncAnimationLoop)
        window.addEventListener('resize', scheduleResize, { passive: true })
        window.visualViewport?.addEventListener('resize', scheduleResize, { passive: true })

        resizeCanvas()
        syncAnimationLoop()

        window.addEventListener('pagehide', () => {
            window.cancelAnimationFrame(animationFrameId)
            window.clearTimeout(resizeTimer)
            mirrorObserver?.disconnect()
            motionMediaQuery.removeEventListener('change', handleMotionChange)
            document.removeEventListener('visibilitychange', syncAnimationLoop)
            window.removeEventListener('pointermove', handlePointerMove)
            window.removeEventListener('resize', scheduleResize)
            window.visualViewport?.removeEventListener('resize', scheduleResize)
            gl.deleteBuffer(positionBuffer)
            gl.deleteProgram(program)
            gl.deleteShader(vertexShader)
            gl.deleteShader(fragmentShader)
        }, { once: true })
    }
</script>
