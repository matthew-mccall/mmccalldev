---
import { cn } from '@/lib/utils'
import Tab from '@/components/Tab.astro'

type Props = {
    href?: string
    class?: string
    bodyClass?: string
}

const { href, class: className, bodyClass } = Astro.props

const Root = href ? 'a' : 'section'
const rootProps = href ? { href } : {}
---

<Root {...rootProps} class={cn('group relative flex flex-col', className)}>
    <Tab
        class="self-start text-[0.65rem] font-medium uppercase tracking-[0.2em] text-maroon/80 transition-colors duration-300 group-hover:text-crimson-deep/80 group-focus-visible:text-crimson-deep/80"
        labelClass="px-4"
    >
        <slot name="tab" />
    </Tab>
    <div
        class={cn(
            'frosted-surface flex flex-col gap-4 rounded-[1.35rem] rounded-tl-none bg-linear-to-b from-maroon/80 to-maroon-deep/70 p-6 transition-colors duration-300 group-hover:from-crimson-deep/80 group-hover:to-maroon-deep/80 group-focus-visible:from-crimson-deep/80 group-focus-visible:to-maroon-deep/80 md:p-8',
            bodyClass,
        )}
        data-squircle="0 0.75 0.75 0.75"
    >
        <slot />
    </div>
</Root>
