---
import { cn } from '@/lib/utils'

type Props = {
    icon: string
    link: string
    title: string
    class?: string
}

const { icon, link, title, class: className } = Astro.props
---

<a href={link} title={title} aria-label={title} class={cn('transition-colors', className)}>
    <i class={`bi-${icon}`} aria-hidden="true"></i>
</a>
